rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function ownsRegisteredDocument() {
        return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      function remainsRegistered() {
        return request.resource.data.accountType == 'registered';
      }

      allow read: if ownsRegisteredDocument();
      allow create, update: if ownsRegisteredDocument() && remainsRegistered();
      allow delete: if ownsRegisteredDocument();
    }
  }
}
